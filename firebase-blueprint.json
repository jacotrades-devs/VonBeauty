{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "Customer booking request for beauty services",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Customer name" },
        "email": { "type": "string", "format": "email", "description": "Customer email" },
        "service": { "type": "string", "enum": ["Event Makeup", "Pageant Makeup", "Photoshoot Makeup", "Bridal Makeup", "Transformation"], "description": "Type of service" },
        "date": { "type": "string", "format": "date", "description": "Booking date" },
        "time": { "type": "string", "description": "Booking time" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Cancelled"], "description": "Booking status" },
        "notes": { "type": "string", "description": "Additional notes" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "email", "service", "date", "time", "status"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Customer review and rating",
      "type": "object",
      "properties": {
        "author": { "type": "string", "description": "Reviewer name" },
        "quote": { "type": "string", "description": "Review text" },
        "rating": { "type": "number", "description": "Rating out of 5" },
        "role": { "type": "string", "description": "Reviewer role or context" },
        "image": { "type": "string", "description": "Reviewer photo URL" },
        "status": { "type": "string", "enum": ["pending", "approved"], "description": "Approval status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["author", "quote", "rating", "status"]
    },
    "GalleryImage": {
      "title": "GalleryImage",
      "description": "Image in the portfolio gallery",
      "type": "object",
      "properties": {
        "src": { "type": "string", "description": "Image URL" },
        "imageUrl": { "type": "string", "description": "Image download URL" },
        "storagePath": { "type": "string", "description": "Firebase Storage path" },
        "category": { "type": "string", "description": "Image category" },
        "categoryId": { "type": "string", "description": "Category identifier" },
        "categoryName": { "type": "string", "description": "Category display name" },
        "gender": { "type": "string", "enum": ["Female", "Male", "Gender-Inclusive"], "description": "Target gender or demographic" },
        "demographic": { "type": "string", "enum": ["Female", "Male", "Gender-Inclusive"], "description": "Target demographic" },
        "title": { "type": "string", "description": "Image title or look name" },
        "lookName": { "type": "string", "description": "Specific makeup look name" },
        "isHidden": { "type": "boolean", "description": "Whether the image is hidden from gallery" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Upload timestamp" }
      },
      "required": ["src", "category"]
    },
    "Category": {
      "title": "Category",
      "description": "Makeup style or service category",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Category name" },
        "description": { "type": "string", "description": "Category description" },
        "isActive": { "type": "boolean", "description": "Whether the category is active in public dropdowns and filters" },
        "isCore": { "type": "boolean", "description": "Whether this is a core protected service" },
        "isProtected": { "type": "boolean", "description": "Whether this category is protected from deletion" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name"]
    },
    "User": {
      "title": "User",
      "description": "Application user profile",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "User email" },
        "role": { "type": "string", "enum": ["guest", "client", "admin"], "description": "User role" },
        "displayName": { "type": "string", "description": "User display name" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Collection of service bookings"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Collection of customer testimonials"
    },
    "/gallery/{imageId}": {
      "schema": "GalleryImage",
      "description": "Collection of portfolio images"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of custom categories"
    }
  }
}
 